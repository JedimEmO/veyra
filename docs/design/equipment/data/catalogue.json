      "dodge_stamina": 1.0,
      "shield_recharge_delay": 1.0,
      "stamina_capacity": 1.0
    },
    "fitting": "workshop_out_of_combat",
    "stock_part_policy": "integral_retained_with_weapon",
    "pool_rebuild": "min(old_current,new_capacity)",
    "supply_walk_factor": 0.35,
    "supply_interruptions": [
      "attack",
      "fire",
      "sprint",
      "dodge",
      "damaging_hit"
    ],
    "supply_consumption": "atomic_on_successful_completion",
    "cooldown_clock": "played_simulation_seconds_persisted"
  },
  "metrics": {
    "shot_damage": {
      "scope": "weapon",
      "benefit_direction": "higher",
      "meaning": "Damage of one plasma pulse or precision bullet; shotgun value is one complete discharge before pellet distribution. Three-pulse bursts emit three separately resolved pulses."
    },
    "shot_posture": {
      "scope": "weapon",
      "benefit_direction": "higher",
      "meaning": "Posture pressure of one plasma pulse or precision bullet; shotgun value is one complete discharge distributed over pellets, never multiplied by pellet count."
    },
    "repeat_interval": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Interval between allowed discharges, or between start times of bursts. Burst size and intra-burst timing are separate future fields."
    },
    "capacity": {
      "scope": "weapon",
      "benefit_direction": "higher",
      "meaning": "Loaded ammunition units: one per plasma pulse or precision bullet, one shell per complete shotgun discharge. A three-pulse burst needs three units. Floor final absolute capacity once, minimum one; absolute burst capacity must also fit a full burst."
    },
    "reload_time": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Seconds committed to a complete reload; no automatic ammunition creation."
    },
    "aim_spread": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Angular dispersion while aimed. A future absolute positive cone is required."
    },
    "equip_time": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Seconds committed to readying this weapon."
    },
    "aim_move_speed": {
      "scope": "weapon",
      "benefit_direction": "higher",
      "meaning": "Movement speed while aiming, capped by future absolute motor constraints."
    },
    "recoil_recovery": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Seconds for recoil displacement to settle; not raw damage or guaranteed accuracy."
    },
    "heat_per_shot": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Heat added by a support-projector discharge."
    },
    "cooling_rate": {
      "scope": "weapon",
      "benefit_direction": "higher",
      "meaning": "Heat removed per second while permitted to cool."
    },
    "brace_time": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Seconds required to enter support-projector braced handling."
    },
    "hit_damage": {
      "scope": "weapon",
      "benefit_direction": "higher",
      "meaning": "Damage of a connected melee action; eventually applied to its own action rows."
    },
    "hit_posture": {
      "scope": "weapon",
      "benefit_direction": "higher",
      "meaning": "Posture pressure of a connected melee action."
    },
    "attack_stamina": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Stamina cost of melee attacks only; excludes dodge."
    },
    "recovery_time": {
      "scope": "weapon",
      "benefit_direction": "lower",
      "meaning": "Post-contact melee commitment; does not scale contact windows or animation wholesale."
    },
    "sprint_speed": {
      "scope": "actor",
      "benefit_direction": "higher",
      "meaning": "Actor sprint speed; no change to walking speed."
    },
    "dodge_stamina": {
      "scope": "actor",
      "benefit_direction": "lower",
      "meaning": "Actor stamina cost of Dodge."
    },
    "shield_recharge_delay": {
      "scope": "actor",
      "benefit_direction": "lower",
      "meaning": "Seconds since last damaging hit before shield recovery; requires separating current shared hurt timer."
    },
    "stamina_capacity": {
      "scope": "actor",
      "benefit_direction": "higher",
      "meaning": "Maximum stamina; increasing it does not restore current stamina."
    }
  },
