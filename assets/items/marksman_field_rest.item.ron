// The Marksman field rest of `crates/veyra-weapons` (`marksman_field_rest`,
// which fits the marksman rifle alone): paired legs on the support mount
// (ticket 0010, step 4). Its aim spread reaches the fight; its brace time has
// no number there yet and reads as not in the fight yet.
(
    id: "veyra:module.marksman_field_rest",
    name: "Marksman field rest",
    maker: "Vigil",
    kind: Module(
        slot: "support",
        fits: ["veyra:weapon.marksman_rifle"],
        part: "marksman_field_rest",
        effects: [
            (property: AimSpread, factor: 0.97, line: "aim_spread"),
            (property: BraceTime, factor: 1.1, line: "brace_time"),
        ],
    ),
    stack: 20,
    lines: [
        (id: "aim_spread", name: "Spread"),
        (id: "brace_time", name: "Brace"),
    ],
    icon: (
        shape: Gem,
        color: "#7FD1FF",
        picture: Some("marksman_rifle/support.marksman_field_rest.png"),
        symbol: Some("veyra:icon.module.stock"),
    ),
)
