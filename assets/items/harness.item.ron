    name: "Harness",
    maker: "the dealer",
    kind: Component,
    stack: 20,
    price: Some(80),
    lines: [
        (id: "conductance", name: "Conductance"),
    ],
    icon: (shape: Gem, color: "#E08A5B", symbol: Some("veyra:icon.crafting.component")),
)
