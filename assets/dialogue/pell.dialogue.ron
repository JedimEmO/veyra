// Pell's conversations at the station (ticket 0014, branch A). Blunt,
// unashamed and fair by his own lights: not an outlaw, not a friend, a
// living. The core can be taken, bought, or talked out of him, with what
// Teague said of the intake or with a second try.
(
    version: 1,
    nodes: [
        (id: "pell.hub", speaker: "veyra:person.pell",
         line: "That mast's ours till someone pays for it, and the core's the only thing on it worth carrying. Don't look at me like that. I'm not an outlaw, I just work.",
         replies: [
            (text: "Hand over the core, or we take it from you.",
             effects: [
                Hostile("pell"),
                SetFlag("pell_fight"),
                Deed(Assembly, Hurt, 1),
                SetStage("arrival", "pell_fight"),
             ], next: Node("pell.fight")),
            (text: "Two hundred credits for the core, and you go.",
             effects: [Pay(200), SetFlag("core"), SetStage("arrival", "mending")], next: Node("pell.paid")),
            (text: "Teague says the processor's intake is drinking your river too.",
             when: [Flag("asked_intake")],
             why: Some("You haven't heard Teague out about the intake."),
             effects: [SetFlag("core"), SetFlag("array"), SetStage("arrival", "mending")], next: Node("pell.talked")),
            (text: "Hear us out.",
             when: [NotFlag("asked_intake"), NotFlag("pell_tried")], hidden: true,
             effects: [SetFlag("pell_tried")], next: Node("pell.refuse")),
            (text: "Your crew drinks from that river too. So does everyone you sell to.",
             when: [Flag("pell_tried"), NotFlag("asked_intake")], hidden: true,
             effects: [SetFlag("core"), SetFlag("array"), SetStage("arrival", "mending")], next: Node("pell.talked")),
        ]),
        (id: "pell.refuse", speaker: "veyra:person.pell",
         line: "Words don't feed a crew. Give me a reason that isn't about you, or pay, or go.",
         replies: [(text: "All right. Listen again.", next: Node("pell.hub"))]),
        (id: "pell.fight", speaker: "veyra:person.pell",
         line: "Your call. Up, all of you; they want it the hard way.",
         replies: []),
        (id: "pell.paid", speaker: "veyra:person.pell",
         line: "Pleasure. The core's yours and we're gone by dark. Nobody needs to hear where it came from.",
         replies: [(text: "Nobody will.", next: End)]),
        (id: "pell.talked", speaker: "veyra:person.pell",
         line: "Fine, take the core; I've kids who drink that water. For what it's worth, the sensor array was gone before we got here. Went to the {holder} yard, the way I heard it.",
         replies: [(text: "That's worth a lot. Thank you.", next: End)]),
        (id: "pell.angry", speaker: "veyra:person.pell",
         line: "You wanted it the hard way.",
         replies: []),
        (id: "pell.idle", speaker: "veyra:person.pell",
         line: "We're done here. Nothing on that mast I'd sell you twice.",
         replies: [(text: "Right.", next: End)]),
    ],
)
