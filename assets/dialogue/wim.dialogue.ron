// Wim Larrow's conversations at his channel (ticket 0014, branch B). Worn,
// angry at the right people, ashamed of what he did and not sorry. The
// household can hear him out, promise to leave his pump running, or
// threaten him into a fight; afterwards he knows how the record went.
(
    version: 1,
    nodes: [
        (id: "wim.idle", speaker: "veyra:person.wim_larrow",
         line: "If you're not here about the water, I've work to do.",
         replies: []),
        (id: "wim.hub", speaker: "veyra:person.wim_larrow",
         line: "You're from the station, then. My allotment from {assembly} was cut by a third the year the processor's new intake opened, so I cut a channel. I'm not proud of it, and I'm not sorry.",
         replies: [
            (text: "How much is your channel taking?", next: Node("wim.share")),
            (text: "We'll leave your pump running.",
             effects: [SetFlag("pump_left")], next: Node("wim.left")),
            (text: "Shut the channel now, or we'll make you.",
             effects: [
                Hostile("wim_larrow"),
                SetFlag("wim_threatened"),
                Deed(Assembly, Hurt, 1),
                SetStage("arrival", "wim_fight"),
             ], next: Node("wim.fight")),
            (text: "We'll decide who hears about this.", next: End),
        ]),
        (id: "wim.share", speaker: "veyra:person.wim_larrow",
         line: "About a fifth of what's gone missing, your station will tell you. The rest goes into the processor's intake, and nobody's cutting a channel off that.",
         replies: [
            (text: "We'll leave your pump running.",
             effects: [SetFlag("pump_left")], next: Node("wim.left")),
            (text: "Shut the channel now, or we'll make you.",
             effects: [
                Hostile("wim_larrow"),
                SetFlag("wim_threatened"),
                Deed(Assembly, Hurt, 1),
                SetStage("arrival", "wim_fight"),
             ], next: Node("wim.fight")),
            (text: "We'll decide who hears about this.", next: End),
        ]),
        (id: "wim.left", speaker: "veyra:person.wim_larrow",
         line: "Then you're kinder than the borough's been. Tell whoever you tell that my trees were dying first.",
         replies: [(text: "We'll tell them.", next: End)]),
        (id: "wim.fight", speaker: "veyra:person.wim_larrow",
         line: "You'd do their work for them? Then come on.",
         replies: []),
        (id: "wim.angry", speaker: "veyra:person.wim_larrow",
         line: "I've nothing more to say to you.",
         replies: []),
        (id: "wim.waiting", speaker: "veyra:person.wim_larrow",
         line: "You've seen what I've done. Go and tell whoever you're telling. The pump's here when they come.",
         replies: []),
        (id: "wim.after_assembly_shut", speaker: "veyra:person.wim_larrow",
         line: "The council made my channel lawful, after you'd shut my pump. The water's back, and half the orchard isn't.",
         replies: []),
        (id: "wim.after_shut", speaker: "veyra:person.wim_larrow",
         line: "You shut my pump. The trees will be gone by summer, and you did it for the people who took the water first.",
         replies: []),
        (id: "wim.after_left", speaker: "veyra:person.wim_larrow",
         line: "Pump's still running, thanks to you. I'm not proud of it. The trees don't care either way.",
         replies: [(text: "Look after them.", next: End)]),
        (id: "wim.after_assembly", speaker: "veyra:person.wim_larrow",
         line: "The council made my channel lawful. I can look my neighbours in the eye again. I didn't think I'd say that this year.",
         replies: [(text: "We're glad.", next: End)]),
        (id: "wim.after_keepers", speaker: "veyra:person.wim_larrow",
         line: "So {keepers} published your record. Someone will be out to close my channel within the month. I'd likely have done the same in your place.",
         replies: [(text: "We're sorry it came to that.", next: End)]),
        (id: "wim.after_holder", speaker: "veyra:person.wim_larrow",
         line: "The company bought your record, I hear. Nobody's coming to close my channel, and nobody's coming to close their intake either.",
         replies: []),
    ],
)
