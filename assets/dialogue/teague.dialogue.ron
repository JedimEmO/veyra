// Dr Anouk Teague's conversations (ticket 0014): the field officer of the
// nearest conservation body, at the Exchange. Precise, dry, impatient with
// waste, and honest about what she does not know. Her station is the
// questline's errand, and she is one of the three it can end with.
(
    version: 1,
    nodes: [
        (id: "teague.idle", speaker: "veyra:person.anouk_teague",
         line: "I'm busy. If Coyle sends you to me, come back then.",
         replies: [(text: "Right.", next: End)]),
        (id: "teague.test", speaker: "veyra:person.anouk_teague",
         line: "You're one of Coyle's arrivals. My station past the road's end went dark eleven days ago, and I don't send strangers out untested. Beat the sentry on the training ground at the city's edge, learn from a trainer, then come back.",
         replies: [
            (text: "Why us?", next: Node("teague.why")),
            (text: "What does {holder} make of your station going dark?",
             effects: [SetFlag("asked_intake")], next: Node("teague.intake_test")),
            (text: "We'll be back.", next: End),
        ]),
        (id: "teague.why", speaker: "veyra:person.anouk_teague",
         line: "Because nobody else will lend me hands, and you haven't picked a side yet. Both of those are useful to me.",
         replies: [
            (text: "What does {holder} make of your station going dark?",
             effects: [SetFlag("asked_intake")], next: Node("teague.intake_test")),
            (text: "We'll be back.", next: End),
        ]),
        (id: "teague.intake_test", speaker: "veyra:person.anouk_teague",
         line: "{holder} would rather it stayed dark. The processor's intake is drinking the river, and my station was the only thing counting. I can't prove more than that yet.",
         replies: [
            (text: "Why us?", next: Node("teague.why")),
            (text: "We'll be back.", next: End),
        ]),
        (id: "teague.mission", speaker: "veyra:person.anouk_teague",
         line: "Adequate. The station is a long way past the end of the road, and scavengers are stripping its mast as we speak. Get the data core, mend what's broken, and bring me whatever it recorded.",
         replies: [
            (text: "Does {holder} know your station's gone dark?",
             when: [NotFlag("asked_intake")], hidden: true,
             effects: [SetFlag("asked_intake")], next: Node("teague.intake_mission")),
            (text: "How do we get out there?", next: Node("teague.route")),
            (text: "We're on our way.", next: End),
        ]),
        (id: "teague.intake_mission", speaker: "veyra:person.anouk_teague",
         line: "{holder} knows. The processor's intake is drinking the river, and my station was the only thing counting. Keep that in mind when you meet the scavengers.",
         replies: [
            (text: "How do we get out there?", next: Node("teague.route")),
            (text: "We're on our way.", next: End),
        ]),
        (id: "teague.route", speaker: "veyra:person.anouk_teague",
         line: "Not on foot, unless you've an hour to throw away. {holder} sells courier bikes at its board, and Corin Hale will be delighted to tell you about them. Buy one anyway.",
         replies: [(text: "We'll see Corin.", next: End)]),
        (id: "teague.waiting", speaker: "veyra:person.anouk_teague",
         line: "The station is still dark. I can see that from my console, so there's no need to come and tell me.",
         replies: [
            (text: "Does {holder} know your station's gone dark?",
             when: [NotFlag("asked_intake")], hidden: true,
             effects: [SetFlag("asked_intake")], next: Node("teague.intake_mission")),
            (text: "On our way.", next: End),
        ]),
        (id: "teague.mending", speaker: "veyra:person.anouk_teague",
         line: "Good, the core. The mast needs a harness made from a conductor; store stock won't carry the load. My camp kit is still beside the mast, a terminal and a bench, and Ilse Marrow can find you the conductor.",
         replies: [(text: "We'll see to it.", next: End)]),
        (id: "teague.upstream", speaker: "veyra:person.anouk_teague",
         line: "I've seen the readings. A third of the flow gone below the bend, and the estuary turning brackish. Find out who cut that bank before you bring me anything else.",
         replies: [(text: "We're going.", next: End)]),
        (id: "teague.hears", speaker: "veyra:person.anouk_teague",
         line: "You have the record, then. Give it to me and I'll publish it, with every name it touches. That includes Wim Larrow's.",
         replies: [
            (text: "Publish it, Wim's channel and all.",
             when: [NotFlag("array")], hidden: true,
             effects: [
                Ending("keepers"),
                GiveGraded("veyra:tool.survey", 1, {"range": 700}),
                Xp(Survey, 300),
                Deed(Keepers, JobDone, 2),
                Deed(Holder, Hurt, 1),
                If([NotFlag("pump_shut")], [Deed(Assembly, Hurt, 1)]),
             ], next: Node("teague.closing")),
            (text: "Publish it, Wim's channel and the array both.",
             when: [Flag("array")], hidden: true,
             effects: [
                Ending("keepers"),
                GiveGraded("veyra:tool.survey", 1, {"range": 700}),
                Xp(Survey, 300),
                Deed(Keepers, JobDone, 2),
                Deed(Holder, Hurt, 1),
                Deed(Holder, Hurt, 2),
                If([NotFlag("pump_shut")], [Deed(Assembly, Hurt, 1)]),
             ], next: Node("teague.closing_array")),
            (text: "We haven't decided who gets it yet.", next: End),
        ]),
        (id: "teague.closing", speaker: "veyra:person.anouk_teague",
         line: "It goes out tonight, and Wim's channel will have to close. Take this tool; it reads further than the one you came with. You've learned more about reading water this week than most do in a year.",
         replies: [(text: "Thank you, Doctor.", next: End)]),
        (id: "teague.closing_array", speaker: "veyra:person.anouk_teague",
         line: "It goes out tonight. Wim's channel will have to close, and {holder} can explain how my sensor array ended up in its yard. Take this tool; it reads further than the one you came with.",
         replies: [(text: "Thank you, Doctor.", next: End)]),
        (id: "teague.selling", speaker: "veyra:person.anouk_teague",
         line: "Corin Hale says he's buying my station's record. I'd hoped you were better than that.",
         replies: []),
        (id: "teague.after_own", speaker: "veyra:person.anouk_teague",
         line: "The river's being counted again, and the intake has an inspector at its gate. It's a start. Come to me when you want a hand reading the ground.",
         replies: [(text: "We will.", next: End)]),
        (id: "teague.after_assembly", speaker: "veyra:person.anouk_teague",
         line: "You gave the record to the borough. The council will weigh Wim's water, and the estuary keeps going brackish meanwhile. I hope that's a trade you can live with.",
         replies: [(text: "It was a hard call.", next: End)]),
        (id: "teague.after_assembly_fallen", speaker: "veyra:person.anouk_teague",
         line: "You gave the record to the borough, and Wim Larrow is dead. I hope the council does better by his family than it did by his river.",
         replies: [(text: "So do we.", next: End)]),
        (id: "teague.after_holder", speaker: "veyra:person.anouk_teague",
         line: "You sold my station's record to {holder}. I have nothing more to say to you about the station.",
         replies: []),
        (id: "teague.after_skip", speaker: "veyra:person.anouk_teague",
         line: "My station is still dark. If you ever want to be useful, you know where I am.",
         replies: [(text: "Maybe one day.", next: End)]),
    ],
)
