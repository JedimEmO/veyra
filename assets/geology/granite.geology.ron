// Granite massif: domes and sheer walls, pale, few beds, boulders. Sheeting
// joints parallel to the surface round the hills into domes and keep walls
// sheer; ice or a fast main river leaves the side valleys hanging.
(
    id: "strata:granite",
    name: "Granite massif",
    tint: (0.93, 0.66, 0.70),
    deal_order: 0,
    rock: (
        // Its own layer (pale speckled crystals peeling in sheets), baked by `just content`.
        face: "strata:granite",
        bare_slope: 0.8,
        far_tint: (1.04, 1.02, 1.0),
        // 0.9 in the design. 1 for now, as its order of work has it for
        // step 3b, so that bare badlands are that step's one visible change;
        // 0.9 waits for a step that judges it on screen.
        cover: 1.0,
    ),
    // Step 4 (ticket 0004): billow domes, the plains' at five times the
    // biome's amplitude and two and a half its wavelength (1.6 and 1.3 in
    // the design), so the domes stand tens of metres and a kilometre or
    // more apart; and a tundra rule. Also away from the design, with no
    // reason step 4 recorded (found by its review): the hills' wavelength
    // 1.2 (0.9), and the `ridges` rule's numbers, set by eye on the maps.
    relief: [
        (class: "plains", shape: "billow", amplitude: 5.0, wavelength: 2.5, erosion: 0.5),
        (class: "hills", shape: "billow", amplitude: 1.3, wavelength: 1.2, erosion: 0.6),
        (class: "mountains", shape: "ridged", amplitude: 1.0, wavelength: 1.0, erosion: 0.7),
        (class: "ridges", shape: "billow", amplitude: 3.0, wavelength: 2.0, erosion: 0.5),
    ],
    beds: (strength: 0.0),
    water: (section: "trough", keep_pits_m: 6.0, hang: 0.5),
    kit: [
        (species: "strata:granite_cliff", weight: 1.0),
        (species: "strata:granite_boulder", weight: 1.0),
        (species: "strata:granite_stone", weight: 1.0),
    ],
)
