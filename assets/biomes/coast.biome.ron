// Shelf, beach and the first strip of land. Flat on purpose: the continent
// stage gives it its slope, and dunes belong to the desert.
(
    id: "strata:coast",
    name: "Coast",
    climate: (
        temperature: (min: 0.0, max: 1.0),
        moisture: (min: 0.0, max: 1.0),
        elevation: (min: 0.45, max: 0.55),
    ),
    relief: (kind: "plains", amplitude_m: 4.0, wavelength_m: 400.0, octaves: 2),
    surface: (material: "strata:sand", slope_material: "strata:rock", slope_threshold: 0.9),
    tint: (0.85, 0.80, 0.55),
    // The ground's palette colour (ticket 0006): a pale sand, cooler for the wet.
    ground: (0.80, 0.78, 0.62),
    // Cool and clear: a sea light, a little bluer than inland, the
    // brights a touch brighter and the colour held back so the sand
    // reads pale. No contrast: Bevy's pivots at linear 0.5, so above 1
    // it crushes every dark paint and shade.
    // Shade colour (visual.md F4): Teal shade: green and blue over red, the water's colour in the shadows of sand and rock.
    grade: (temperature: -0.008, saturation: 0.95, gain: 1.03, shade: (0.86, 1.04, 1.10)),
)
