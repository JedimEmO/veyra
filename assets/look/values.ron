// The value budget (review step six, visual.md F1): the albedo each family of
// surface may have, as linear luminance, and which family every shipped
// material belongs to. Read by `strata_data::values` (Bevy-free). The terrain
// draws a `terrain/` member remapped to its target at runtime and derives each
// biome's far colour from its surface layer's target (terrain.wgsl and
// `strata_terrain::mesh`); `tools/content/tests/values.rs` reads every baked base
// map and holds the rest to their family's band, with `pending` naming the step
// that lands a member still out of it (the test fails if a pending member is in
// band, so the list shrinks as the steps land).
//
// Family bands: `min` to `max` the mean, `spread` the most the standard
// deviation of a member's luminance may be. `target` is what a member is drawn
// at where it names none of its own. The trailing numbers are the baked mean
// and spread when the table was written; `cargo run -p content --example
// value_table --release` prints the current ones.
(
    families: {
        "ground": (target: 0.19, min: 0.14, max: 0.24, spread: 0.14),
        "sand": (target: 0.29, min: 0.26, max: 0.32, spread: 0.1),
        "snow": (target: 0.65, min: 0.6, max: 0.7, spread: 0.08),
        "stone": (target: 0.2, min: 0.08, max: 0.35, spread: 0.12),
        "paving": (target: 0.18, min: 0.1, max: 0.3, spread: 0.1),
        "leaves": (target: 0.15, min: 0.1, max: 0.16, spread: 0.06),
        // A tree's far picture: the leaves' band with room above for the crown
        // grouping (`canopy.ron`) baked into the atlas, whose lit clumps lift
        // the mean of a pale species (birch) a few points.
        "crown": (target: 0.15, min: 0.1, max: 0.19, spread: 0.06),
        "bark": (target: 0.12, min: 0.08, max: 0.2, spread: 0.1),
        "shell": (target: 0.48, min: 0.4, max: 0.55, spread: 0.1),
        "finish": (target: 0.22, min: 0.1, max: 0.4, spread: 0.16),
        "dark": (target: 0.04, min: 0.005, max: 0.12, spread: 0.06),
        // The spread is a little wide: lit cloth panels and darker gear are two
        // populations in one map, 0.38 against 0.18 (tools/character_values.py).
        "character": (target: 0.22, min: 0.15, max: 0.3, spread: 0.18),
    },
    // How a body wears a household or faction colour: the lift added to the
    // cloth beside the multiply, the share of it given off as light (a lamp's,
    // not a lit body's) and the most metal the body keeps. The rim is a
    // hostile's alone (visual.md F6): its colour in sRGB, the share of it a
    // grazing pixel adds and the fresnel exponent (`hostile_rim.wgsl`).
    character: (own_lift: 0.1, own_glow: 0.03, own_metallic: 0.3, rim_colour: (1.0, 0.45, 0.3), rim_strength: 0.6, rim_power: 2.5),
    materials: {
        "terrain/clay": (family: "ground", target: Some(0.24)),  // 0.342 / 0.066
        "terrain/forest_floor": (family: "ground", target: Some(0.22)),  // 0.065 / 0.037
        "terrain/grass": (family: "ground", target: Some(0.19)),  // 0.093 / 0.047
        "terrain/gravel": (family: "ground", target: Some(0.16)),  // 0.143 / 0.091
        "terrain/soil": (family: "ground", target: Some(0.19)),  // 0.055 / 0.018
        "terrain/sand": (family: "sand"),  // 0.417 / 0.051
        "terrain/snow": (family: "snow"),  // 0.805 / 0.034
        "bridge/ford-stone": (family: "stone"),  // 0.338 / 0.026
        "bridge/masonry": (family: "stone"),  // 0.113 / 0.034
        "impostors/granite_boulder": (family: "stone"),  // 0.332 / 0.02
        "impostors/granite_cliff": (family: "stone"),  // 0.338 / 0.015
