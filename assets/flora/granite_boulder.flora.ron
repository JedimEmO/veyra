// Weathered granite boulders: on knolls and ridge shoulders, each with a
// few stones fallen off it. Granite country's own; karst and folded rock
// borrow them until they have a kit of their own.
(
    id: "strata:granite_boulder",
    name: "Granite boulder",
    kind: "rock",
    // How rocky each climate and height is; which rock stands there is the
    // province's, by its kit (assets/geology), so a granite and a sandstone
    // species list the same biomes (ticket 0004, step 3e).
    biomes: [
        (biome: "strata:mountains", weight: 0.22),
        (biome: "strata:highlands", weight: 0.18),
        (biome: "strata:desert", weight: 0.14),
        (biome: "strata:tundra", weight: 0.12),
        (biome: "strata:savanna", weight: 0.1),
        (biome: "strata:coast", weight: 0.08),
        (biome: "strata:forest", weight: 0.06),
        (biome: "strata:plains", weight: 0.03),
    ],
    spacing_m: 14.0,
    slope_max: 1.2,
    sea_clearance_m: 1.0,
    size: (min: 0.8, max: 1.4),
    exclusion_m: 3.5,
    tint_dry: (0.5, 0.5, 0.5),
    tint_lush: (0.5, 0.5, 0.5),
    // Boulders gather in fields, with open ground between them.
    cluster: (radius_m: 22.0, clumps_per_ha: 1.5, patch_m: 150.0, patch_cover: 0.5),
    ground: (hollow: -0.5, ridge: 0.3),
    children: [(species: "strata:granite_stone", count: [1, 3], radius_m: [1.8, 4.5])],
)
