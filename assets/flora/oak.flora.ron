// A broadleaf tree for the forests and, thinly, the plains.
(
    id: "strata:oak",
    name: "Oak",
    kind: "tree",
    biomes: [
        (biome: "strata:forest", weight: 0.65),
        (biome: "strata:plains", weight: 0.12),
        (biome: "strata:savanna", weight: 0.06),
    ],
    spacing_m: 9.0,
    slope_max: 0.55,
    altitude_m: (min: 1.0, max: 900.0),
    sea_clearance_m: 1.5,
    moisture: (min: 0.3, max: 1.0),
    // A plains oak stands alone in poor ground, so a tenth of the chance
    // survives a bare patch.
    cover_floor: 0.1,
    size: (min: 0.75, max: 1.3),
    exclusion_m: 3.0,
    tint_dry: (0.30, 0.42, 0.10),
    tint_lush: (0.14, 0.40, 0.08),
    // Oaks gather into groves with glades between them, and shelter ferns.
    cluster: (radius_m: 20.0, clumps_per_ha: 3.0, patch_m: 90.0, patch_cover: 0.7),
    children: [(species: "strata:woodland_fern", count: [0, 3], radius_m: [2.0, 6.0])],
    tree: (
        height_m: (min: 8.0, max: 12.0),
        levels: 4,
        branch_factor: 3,
        taper: 0.68,
        split_angle_deg: 38.0,
        trunk_ratio: 0.035,
        card_ratio: 0.16,
        bark: "oak",
        leaves: "broad",
        // Baked by the content step; the tree library's count wins.
        variants: 6,
    ),
)
