// What a cleared derelict machine leaves in its cache (ticket 0012, step
// 5b): its rarest salvage. Few credits, mount blanks and drive coils whose
// lines are the best of any table (tier 1 about 400 to 800, tier 3 about 550
// to 950) and the rare modules at about twice a camp's chance.
//
// Worth at Pelagic's board, a clearing's average over 600 seeds (the sim's
// `loot` test holds the bands): tier 1 about 100 credits, tier 2 about 270,
// tier 3 about 540; the board buys few of its parts, so the worth sits under
// a camp's by design.
(
    version: 1,
    encounter: "strata:machine_security",
    lots_within_m: 4000.0,
    tiers: [
        // Tier 1.
        (
            credits: (30, 80),
            picks: [
                (item: "veyra:component.mount_blank", count: (1, 2), chance: 500, lines: Some((400, 800))),
                (item: "veyra:component.drive_coil", count: (1, 2), chance: 600, lines: Some((400, 800))),
                (item: "veyra:component.cell_core", count: (1, 1), chance: 400, lines: Some((400, 800))),
            ],
            lots: [
                (class: "strata:reactive", units: (20, 50), chance: 400),
            ],
            rare: [
                (item: "veyra:module.patrol_extended_feed", count: (1, 1), chance: 40, lines: Some((400, 800))),
            ],
        ),
        // Tier 2.
        (
            credits: (80, 200),
            picks: [
                (item: "veyra:component.mount_blank", count: (1, 3), chance: 600, lines: Some((480, 880))),
                (item: "veyra:component.drive_coil", count: (2, 3), chance: 700, lines: Some((480, 880))),
                (item: "veyra:component.cell_core", count: (1, 2), chance: 500, lines: Some((480, 880))),
            ],
            lots: [
                (class: "strata:reactive", units: (40, 100), chance: 500),
            ],
            rare: [
                (item: "veyra:module.patrol_extended_feed", count: (1, 1), chance: 100, lines: Some((480, 880))),
                (item: "veyra:module.vigil_reflex", count: (1, 1), chance: 80, lines: Some((480, 880))),
            ],
        ),
        // Tier 3.
        (
            credits: (160, 380),
            picks: [
                (item: "veyra:component.mount_blank", count: (2, 4), chance: 700, lines: Some((550, 950))),
                (item: "veyra:component.drive_coil", count: (2, 4), chance: 800, lines: Some((550, 950))),
                (item: "veyra:component.cell_core", count: (2, 3), chance: 600, lines: Some((550, 950))),
            ],
            lots: [
                (class: "strata:reactive", units: (80, 180), chance: 600),
            ],
            rare: [
                (item: "veyra:module.patrol_extended_feed", count: (1, 1), chance: 180, lines: Some((550, 950))),
