// How far from Port Serein a fight is, and what that does to the people in
// it (ticket 0012, step 2). A tier is the band a place's distance from the
// city's centre falls in; a person's pools and blows are the opponents.ron
// row times the tier's factors. The staging fight is tier 0 and reads none.
(
    version: 1,
    // Port Serein's centre in world metres `(x, z)`: its settlement file's
    // `at`, which a test holds this to.
    centre: (-400.0, -500.0),
    // Tier 1 is under the first figure, tier 2 under the second, tier 3
    // beyond. Metres.
    bands_m: [6000.0, 15000.0],
    // One row a tier, tier 1 first.
    tiers: [
        (health: 1.0, shield: 1.0, damage: 1.0),
        (health: 1.3, shield: 1.3, damage: 1.15),
        (health: 1.7, shield: 1.7, damage: 1.3),
    ],
)
