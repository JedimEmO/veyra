    profession: Some("weaponsmith.fittings.4"),
    licence: None,
    fixture: None,
    slots: [
        (id: "metal", name: "Metal", takes: Class("strata:structural_metal"), units: 40),
        (id: "seals", name: "Seals", takes: Commodity("veyra:commodity.seal_set"), count: 1),
    ],
    lines: [
        (line: "aim_spread", from: [
