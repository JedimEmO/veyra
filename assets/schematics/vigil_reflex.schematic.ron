// The Vigil reflex sight (ticket 0009, step 5): a harness, 10 units of any
// conductor and a seal set. Aim spread is the harness's conductance and the
// conductor's stability; the draw is quicker the lighter the conductor is,
// as the extended feed's reload is. Taught by Fittings 3 of the Weaponsmith.
// Read by `strata_registry::schematic`; in no world version and no
// handshake.
(
    id: "veyra:schematic.vigil_reflex",
    makes: "veyra:module.vigil_reflex",
    complexity: 2,
    profession: Some("weaponsmith.fittings.3"),
    licence: None,
    fixture: None,
    slots: [
        (id: "harness", name: "Harness", takes: Component("veyra:component.harness"), count: 1),
        (id: "conductor", name: "Conductor", takes: Class("strata:conductor"), units: 10),
        (id: "seals", name: "Seals", takes: Commodity("veyra:commodity.seal_set"), count: 1),
    ],
    lines: [
        (line: "aim_spread", from: [
            (slot: "harness", stat: Line("conductance"), weight: 0.5),
            (slot: "conductor", stat: Attribute(Stability), weight: 0.5),
        ]),
        (line: "equip_time", from: [
            (slot: "conductor", stat: Light(Density), weight: 1.0),
        ]),
    ],
)
