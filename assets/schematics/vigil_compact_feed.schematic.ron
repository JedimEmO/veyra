// The rifle's compact magazine (ticket 0010, step 4; its id is `vigil_` so it sorts after the carbine's and
// a harness or a core is still read through the first schematic that used it): a cell core, a harness,
// 40 units of light alloy ore for the casing and a seal set, as the patrol
// carbine's extended feed is. Capacity is mostly the core's charge density;
// handling is how light and strong the casing is. Taught by Fittings 2 of the
// Weaponsmith. Read by `strata_registry::schematic`; in no world version and
// no handshake.
(
    id: "veyra:schematic.vigil_compact_feed",
    makes: "veyra:module.marksman_compact_feed",
    complexity: 2,
    profession: Some("weaponsmith.fittings.2"),
    licence: Some("veyra:maker.vigil"),
    fixture: Some("cells"),
    slots: [
        (id: "core", name: "Cell core", takes: Component("veyra:component.cell_core"), count: 1),
        (id: "harness", name: "Harness", takes: Component("veyra:component.harness"), count: 1),
        (id: "casing", name: "Casing", takes: Type("strata:light_alloy_ore"), units: 40),
        (id: "seals", name: "Seals", takes: Commodity("veyra:commodity.seal_set"), count: 1),
    ],
    lines: [
        (line: "capacity", from: [
            (slot: "core", stat: Line("charge_density"), weight: 0.60),
            (slot: "harness", stat: Line("conductance"), weight: 0.25),
            (slot: "casing", stat: Attribute(Purity), weight: 0.15),
        ]),
        (line: "reload_time", from: [
            (slot: "casing", stat: Light(Density), weight: 0.60),
            (slot: "casing", stat: Attribute(Strength), weight: 0.40),
        ]),
    ],
)
