// The log of ticket 0010, step 8, second half: every dial the tuning pass
// moved, from what to what, and why. `balance worth` writes the page's
// "What changed in this tuning" table from this file, so it is kept as the
// tuning goes and nothing else writes it. A dial is the file it lives in and
// the path inside it; `from` and `to` are the figures as written there.
// Every dial moved is inside the limit of its value at the start of the pass
// (abilities 0.5 to 2.0 times, the Rifle row 0.8 to 1.25, the marksman and
// duelist rows 0.6 to 1.6).
(
    version: 1,
    changes: [
        (
            dial: "progression/opponents.ron rusher.learned",
            from: "blade.novice, blade.cuts.1 to 3",
            to: "blade.novice, blade.cuts.1 and 2",
            why: "Since step 7 One hand 3 gives the Heavy 1.15 of its posture, so the game's rusher swung 92 where the harness's rusher swung 80 and where it swung before step 7. Without the box the game's rusher reads what it read before: Heavy posture 80, damage 55, no other figure of the rusher moved.",
        ),
        (
            dial: "opponents.ron marksman.recover",
            from: "2.8",
            to: "2.2",
            why: "A carbine that stands and fires from 60 m won 0.33 of its bouts against the marksman; the band wants at most 0.15 (0.00 now). The wait after a shot is the one dial that moves it without making the marksman a different weapon.",
        ),
        (
            dial: "opponents.ron marksman.cooldown",
            from: "1.5",
            to: "0.9",
            why: "The wait before the first charge. The rifle that walks across the line and stops to aim needs about 5 s to win, and the marksman's first shot came at 3.1 s; at 2.5 s it fires in every bout, so the duel is a duel.",
        ),
        (
            dial: "opponents.ron marksman.walk_speed",
            from: "2.2",
            to: "1.8",
            why: "A greatblade cut roots its user for 0.70 s and a marksman that backs away at 2.2 m/s is never there when it lands (10 cuts, 0 landed, no bout won). At 1.9 or less the class catches it; 1.8 gives a margin.",
        ),
        (
            dial: "opponents.ron duelist.rest",
            from: "0.3",
            to: "0.5",
            why: "Step 8 had moved it to 0.3 to bring one single-trajectory fight (the guarding blade, 30.9 s) under the 30 s cap. On seeded cutting hands (60 bouts each way) the guarding blade wins 0.88 of its bouts inside 45 s at 0.5 (0.68 inside 30 s, mean 30.1 s) and 1.00 at 0.3 (0.93 inside 30 s, mean 24.1 s), so the rule to move it (under 0.6 inside 45 s at 0.5 and at 0.3) is not met and 0.5 stays; the band that reads the guarding blade is read inside 45 s.",
        ),
        (
            dial: "tools/balance lib.rs rifle hand (walk, stand)",
            from: "1.8 s, 0.6 s",
            to: "0.9 s, 0.9 s",
            why: "A policy figure, not a table: the rifle hand walks across the line and stands to aim. It was set by hand to give the pistol its middle, one shot every 3.3 s against the row's 1.8 s interval. It is now set by a rule: both are about the settling time of the aim (0.875 s), so a cycle is the interval of the row. The pistol holds 0.87 at 30 m and the rifle wins 1.00 at 80 m with it.",
        ),
        (
            dial: "weapons.ron Rifle.aim_time",
            from: "0.7",
            to: "0.875",
            why: "At 30 m the pistol won 0.17 to 0.45 of its bouts against a rifle that stops to aim; the band wants at least half. With the rifle hand set by the rule above, 0.7 reads 0.52 and 0.875 reads 0.87 over 60 bouts.",
        ),
        (
            dial: "abilities.ron disarm.seconds",
            from: "2.5",
            to: "1.5",
            why: "Against the duelist, as one trajectory at a rest of 0.3, disarm halved the damage a blade took (0.45 of the control) and at 1.5 s it read 0.90; the band wanted it between 0.625 and 0.97. Measured as a distribution at the shipped rest of 0.5 it reads 1.12 over four 60 bout windows (1.07 to 1.21), so the dial is not what makes disarm pay against this opponent and the band is unchosen.",
        ),
        (
            dial: "abilities.ron charged_shot.damage",
            from: "1.4",
            to: "1.1",
            why: "Charged shot killed the post at 60 m in 1.8 s against 3.1 s, 1.77 times the plain rifle; the band wants at most 1.60. At 1.1 it reads 1.24.",
        ),
        (
            dial: "abilities.ron explosive_shot.damage",
            from: "1.0",
            to: "1.6",
            why: "Explosive shot read 1.00 of the plain carbine against two targets side by side, dead. Its bolt, its blast, its windup and its length together make it 1.06.",
        ),
        (
            dial: "abilities.ron explosive_shot.blast.damage",
            from: "12",
            to: "24",
            why: "See explosive_shot.damage.",
        ),
        (
            dial: "abilities.ron explosive_shot.windup, length, cancel",
            from: "0.40, 0.80, 0.60",
            to: "0.20, 0.50, 0.30",
            why: "See explosive_shot.damage: the time the carbine does not fire was most of the price.",
        ),
        // Step 9, the bulwark: a row new in this step, so every figure of it
        // was free. Two moves were tried and put back: initial_cooldown 0.4
        // to 7.0 (the blade then won without ever being cut, a fight that
        // does not happen, and the first cut came 7 s into the engagement)
        // and guard.share 0.60 to 0.50. The ones that stand:
        (
            dial: "opponents.ron bulwark.guard.bolts.share",
            from: "0.90",
            to: "0.97",
            why: "At 0.90 a held trigger killed the bulwark through the raised guard (44 blocked rounds against a pool of 105) in 4.7 s, quicker than the carbine that waits for the opening (5.4 s), so playing the gun earned nothing. At 0.97 holding fire takes 6.7 s and 17 to 19 damage, 1.2 times the waiting carbine's seconds. At 1.0 it reads 7.0 s; the stamina of 0.15 a point was left, since 0.5 breaks the guard in 3.7 s.",
        ),
        // The same day, the bulwark's second pass. With the row above a blade
        // was the quicker answer and the bloodier one (4.1 s taking 45 against
        // the punishing carbine's 5.4 s taking 12), because the bulwark cut on
        // arrival and a cut on its guard cost it nothing but stamina. Three
        // rules of its brain were added (its first attack counts from when it
        // gets in reach, a cut met by its guard holds its own back for
        // `pinned`, a broken guard stays down for `stagger_cooldown`) and
        // these figures set with them. At 60 bouts on seeds 1, 101 and 501 a
        // blade that keeps cutting then takes 4.3 s and 5 to 6.5 damage, the
        // punishing carbine 6.3 s and 11 to 12.
        (
            dial: "opponents.ron bulwark.pinned",
            from: "(new)",
            to: "0.9",
            why: "Seconds a cut met by the guard holds the bulwark's own cut back. At 0.6 the greatblade's slower lights did not hold it (its kit took 45 against 14 at 0.9); at 0.9 every class holds it for as long as its stamina keeps the cuts coming.",
        ),
        (
            dial: "opponents.ron bulwark.guard.stamina",
            from: "1.40",
            to: "2.00",
            why: "At 1.40 the fifth light broke the guard and the plain blade took 5.6 s and 14; at 2.00 the third does (33.6 of the bulwark's 100 a blocked light) and it takes 4.3 s and 5. A bolt still spends 0.15 a point.",
        ),
        (
            dial: "opponents.ron bulwark.stagger_cooldown",
            from: "0.8",
            to: "1.2",
            why: "Now also the seconds a broken guard stays down past the stagger. At 0.8 the plain blade took 13 (the guard was back before the second cut of the opening), at 1.2 it takes 4 to 6, at 1.6 nothing, which is no fight.",
        ),
        (
            dial: "opponents.ron bulwark.initial_cooldown",
            from: "0.4",
            to: "0.9",
            why: "Now counted from the bulwark's arrival in reach, not from the start of the fight. At 0.6 the blade's heavy cut took 22; at 0.9 it takes 11, and the punishing carbine pays 0.3 s (6.0 s to 6.3 s).",
        ),
        // Step 9c: the eleven abilities of the worth page that were dead,
        // slight or far too strong, each read on a fight it is for.
        (
            dial: "abilities.ron focus windup, length, cancel",
            from: "0.15, 0.30, 0.30",
            to: "0, 0, 0",
            why: "Made instant, the shape reflect shot has: the press costs a standing rifle nothing (the standing figure reads 1.00, was 0.91) and a rifle that crosses the line fires on the move while the status lasts. Seconds (5) and cooldown (18) are unchanged: on two posts at 60 m the moving hand reads 1.13 of itself.",
        ),
        (
            dial: "abilities.ron butt_strike reach, posture, windup, length, cancel",
            from: "1.7, 70, 0.18, 0.55, 0.40",
            to: "2.2, 105, 0.12, 0.40, 0.30",
            why: "It was never pressed on the bulwark (which holds 2.0 m off) and broke nothing when it was. It now reaches, lands before the cut it answers and breaks a full posture of 100, so the punishing carbine takes 0.0 where it took 11.7, for 0.4 s more (6.70 s against 6.27 s). Under 100 posture it breaks nothing and reads worse than no press.",
        ),
        (
            dial: "abilities.ron fortified damage_taken",
            from: "(new)",
            to: "0.5",
            why: "The status halves the damage taken, after any guard, beside holding posture; nothing else bears the field.",
        ),
        (
            dial: "abilities.ron kinetic_absorb seconds, cooldown",
            from: "4.0, 20.0",
            to: "2.0, 12.0",
            why: "Read on damage taken by the greatblade kit against the duelist. At 2.5 s it read 0.60 once a kit kept the stamina of its next cut, under the 0.625 floor; at 2.0 s it reads 0.68 (42.6 against 62.6) and the fight is 5.1 s against 7.4 s.",
        ),
        (
            dial: "abilities.ron armour_break damage, posture, windup, length, cancel",
            from: "0.8, 1.0, 0.30, 0.70, 0.55",
            to: "0.4, 0.5, 0.30, 0.70, 0.55",
            why: "Review of step 9c: the windup, length and cancel go back to their start, since 0.04 s of them moved the duelist fight more than the blow did. The greatblade pair (0.76, 0.86, 0.72 at three seeds earlier) certifies a pause: a press with the blow and status zeroed reads 0.79, so that band is unchosen. The rifle pair is the fight where the blow is the cause (3.93 s against 4.95 s on the marksman, 6.65 s with the blow zeroed). The melee Hit is a directed cut and a guard meets it; its status lands only when the guard is open.",
        ),
        (
            dial: "abilities.ron disarm seconds, cooldown, windup, length, cancel",
            from: "1.5, 14.0, 0.20, 0.55, 0.45",
            to: "3.0, 7.0, 0.10, 0.35, 0.25",
            why: "Why the blade that disarms took more: the press comes as the duelist's cut begins, and a cut under way is not stopped, so the 0.55 s commitment cost a blow and one disarm of 1.5 s spared none. A quicker hit with twice the seconds spares one: damage taken reads 0.83, 0.85 and 0.85 of the plain blade at three seeds.",
        ),
        (
            dial: "abilities.ron explosive_shot blast damage, blast posture, cooldown",
            from: "24, 60, 16.0",
            to: "48, 90, 10.0",
            why: "Read on seconds to win against the bulwark beside the punishing carbine: 0.90 (6.27 s to 5.66 s). A blast posture of 100 or more breaks the guard outright and ends the fight in 1.4 s, so 90 keeps it a blast and not a key.",
        ),
        (
            dial: "abilities.ron reflect_shot seconds, cooldown, stamina; reflecting reflects",
            from: "4.0, 18.0, 30, 1.0",
            to: "8.0, 9.0, 15, 2.0",
            why: "Read on a guarding blade against the sentry from 12 m: 1.28 of itself on damage a second. The kit blade closing from 27 m or 60 m gains nothing from it (1.00): its only cover is the thrust's 0.28 s, and it meets no bolt with the guard down.",
        ),
        (
            dial: "abilities.ron sweeping_cut damage, cooldown",
            from: "1.1, 10.0",
            to: "1.8, 6.0",
            why: "Against two rushers 1.39, 1.36 and 1.42 of the plain glaive on damage a second; against one 1.00. At a cooldown of 10 the fight (9 s) saw one sweep and the ability read 0.98.",
        ),
        (
            dial: "abilities.ron vault distance, landing damage, cover share",
            from: "10.0, 1.0, 0.8",
            to: "6.5, 1.2, 0.4",
            why: "Against the sentry from 27 m the kit with a 10 m leap took 2.4 where the kit without it took 25; at 6.5 m with a heavier landing and a thinner cover it takes 18 (0.70 of the control). Against the marksman from 60 m it still wins 1.00 where the control wins 0.3 to 0.5.",
        ),
        (
            dial: "abilities.ron rapid_reload cooldown, windup, length, cancel, stamina",
            from: "20.0, 0.25, 0.40, 0.40, 30",
            to: "10.0, 0.125, 0.2, 0.2, 15",
            why: "Read on the carbine against two dummies at 30 m, where the magazine runs dry: 1.08, 1.08 and 1.06 (was 1.035 to 1.04).",
        ),
    ],
)
