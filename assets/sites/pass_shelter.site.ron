// A pass shelter: a refuge hut at the low point of a ridge between two
// valleys, where a trail crosses over.
(
    id: "strata:pass_shelter",
    name: "Pass shelter",
    rank: 4,
    per_1000_km2: 6.0,
    footprint_m: 20.0,
    blend_m: 30.0,
    crown: 0.025,
    max_cut_m: 4.0,
    spacing: (own_m: 4000.0, others_m: 1000.0, settlements_m: 2000.0),
    ground: (
        slope_max: 0.25,
        height_m: (min: 80.0, max: 3200.0),
        biomes: [(id: "strata:ocean", weight: 0.0)],
    ),
    wants: [
        // A saddle: the ridge rising both ways along it, the valleys falling
        // away either side.
        (any: [(feature: "pass", at_least: 15.0, full: 90.0)], weight: 3.0, required: true),
        // Between places people would walk between.
        (any: [
            (feature: "kind", kind: "strata:hamlet", within_m: 4000.0, fade_m: 4000.0),
            (feature: "kind", kind: "strata:town", within_m: 8000.0, fade_m: 5000.0),
            (feature: "settlement", within_m: 10000.0, fade_m: 5000.0),
        ], weight: 1.0),
    ],
    facing: "downhill",
    road: "trail",
    group: "veyra:pass_shelter",
    names: (
        onsets: ["b", "c", "d", "g", "h", "k", "l", "m", "r", "s", "t", "v", "br", "cr", "gr", "sc"],
        vowels: ["a", "e", "i", "o", "u", "ai", "au"],
        codas: ["", "n", "r", "l", "s", "rd", "rn", "g"],
        syllables: [1, 2],
        patterns: ["{root} Pass", "{root} Gap", "{root} Saddle", "{root} Col", "{root}'s Hut"],
    ),
)
