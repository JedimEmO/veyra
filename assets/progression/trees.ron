// The skill graph of docs/design/progression.md: thirteen trees of a
// novice box, four branches of four and a master, costing 6 / 2 4 6 8 / 12
// so a full tree is 98 of a character's 250 points. Each box names the XP
// of its tree's kind it needs and what it does, as effects over the combat
// tables (`Action`, `Weapon`, `Actor` change a field by Set, Add or Mul;
// `Unlock` and `Certify` gate an action or a weapon until the box is
// learned). Only Blade and Marksman carry effects; every other tree is a
// placeholder until its activities exist. Loaded and checked by
// `strata_registry::progression`.
(
    version: 1,
    // Skill points a character has to spend.
    budget: 250,
    // What the XP ledger credits: XP per point of damage a bolt or a blade
    // deals, and the XP a kill is worth.
    rates: (
        damage: 1.0,
        kill: 50,
        // Fabrication XP for making things at a bench: by the schematic's
        // complexity (1 to 3), the first batch of a schematic, each line a
        // batch beats the household's best at, and a rework that raised a line.
        craft: (made: [40, 80, 160], first: 150, best: 50, rework: 60),
        // Survey XP for surveying by hand: a ping that meets a deposit not yet
        // found, one that raises a found deposit's best reading by at least
        // `better_pm`, a deposit's first sampling cycle, and each cycle (times
        // its concentration over 1000, at least 1). An empty ping earns nothing.
        // `harvest` is paid for every ten units collected from a field harvester.
        survey: (find: 120, better: 20, first_sample: 60, cycle: 6, better_pm: 50, harvest: 1),
        // Wilderness XP for a rifle: a rate a point of damage its bolts deal
        // (half the combat rate) and a bonus for a hit that flew `long_m`
        // metres or more (one aimed rifle hit's damage). Paid beside the
        // combat XP of the same hit; a pistol's pays none.
        wilderness: (rifle: 0.5, long: 85, long_m: 50.0),
    ),
    trees: [
        (
